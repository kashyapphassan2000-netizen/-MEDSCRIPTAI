# Copy to deploy/.env and fill in.  NEVER commit the real .env (it is in .gitignore).
ADAPTERS_DIR=/home/ubuntu/-MEDSCRIPTAI/outputs/adapters
HF_HOME=/ephemeral/hf-cache
HF_TOKEN=hf_REPLACE_ME
API_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING
VLLM_IMAGE=vllm/vllm-openai:v0.32.0-cu129
VLLM_ENABLE_CUDA_COMPATIBILITY=1
API_IMAGE=medscriptai-api:v1
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_REPLACE_ME
LANGSMITH_PROJECT=medscriptai
AWS_REGION=us-east-1
