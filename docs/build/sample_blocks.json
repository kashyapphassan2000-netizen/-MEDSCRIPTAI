[{"t": "h1", "text": "PART 9 - TEST heading"}, {"t": "h2", "text": "SECTION 9.2 - Push your Docker image"}, {"t": "p", "text": "WHERE: VS Code > Terminal (Hyperstack VM)"}, {"t": "p", "text": "GOAL: Store the image in **ECR** with `docker push`."}, {"t": "p", "text": "Step 1. Type exactly:"}, {"t": "code", "text": "aws ecr create-repository \\\n  --repository-name medscriptai-api\n\necho done"}, {"t": "p", "text": "You should see: Login Succeeded"}, {"t": "p", "text": "Watch out: forget `--region` and it fails. See https://fakecloud.dev/docs"}, {"t": "table", "rows": [["Step", "FakeCloud (free practice)", "Real AWS (same step)"], ["Create repo", "`aws --endpoint-url http://localhost:4566 ecr create-repository`", "`aws ecr create-repository --region us-east-1`"], ["Cost", "$0", "$0.10 per GB-month (verify)"]], "blue": [2], "widths": [80, 0, 0]}, {"t": "bullets", "items": ["first **bold** item", "second `code` item"]}, {"t": "p", "text": "CHECKPOINT: repo listed.  If not: run fakecloud."}]