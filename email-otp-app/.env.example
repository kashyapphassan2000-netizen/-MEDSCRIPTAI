PORT=3000
OTP_TTL_MINUTES=5

# --- Real email delivery (fill these to send OTPs to real inboxes) ---
# Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="OTP Service <youraddress@gmail.com>"

# If SMTP_* is empty: emails go to a free Ethereal test inbox (preview link shown in UI).
# Set MAIL_MODE=console to just print OTPs in the server log instead.
# MAIL_MODE=console
